# Copy this file to .secrets.local and fill in real values.
# .secrets.local is gitignored and stays on your machine only.
#
# Format: ONE secret per line, KEY=VALUE, no quotes, no spaces around '='.
# Lines starting with '#' and blank lines are ignored.
#
# Placeholder in committed code looks like: <your KEY_NAME>
# e.g. if you add DB_PASSWORD=xxx here, then
#   - working tree shows: "xxx"
#   - committed file shows: "<your DB_PASSWORD>"

DB_PASSWORD=
# WECHAT_APP_SECRET=
# OPENAI_API_KEY=
DEEPSEEK_API_KEY=<paste your real DeepSeek key here>
# JWT_SECRET=
