# 数据库配置
DB_PASSWORD=123456
DB_NAME=app_test

# Redis 密码（留空表示无密码）
REDIS_PASSWORD=

# AI API 配置（必填）
ARK_API_KEY=your-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# AI 模型配置（可按需修改）
ARK_MODEL_DOC_PARSER=deepseek-v4-flash
ARK_MODEL_REQUIREMENT_ANALYSIS=doubao-seed-2.0-pro
ARK_MODEL_QUESTION_GENERATION=deepseek-v4-flash
ARK_MODEL_TEST_CASE_GENERATION=doubao-seed-code
ARK_MODEL_RESULT_ANALYSIS=deepseek-v4-pro

# Agent 模块（可交互测试 Agent）配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
JWT_SECRET=replace-with-a-long-random-secret
AGENT_DATA_DIR=./agent-data
